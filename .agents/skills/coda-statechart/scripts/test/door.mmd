stateDiagram-v2
  state "Front door" as Front {
    state "Door" as Door {
      [*] --> Open
      state "Locked" as Locked {
        state "Alarm" as Alarm {
          [*] --> Disarmed
          [*] --> Armed : the timer locks the door
          Disarmed --> Armed : you arm the alarm
          Armed --> Disarmed : you disarm the alarm
          Armed --> Ringing : someone forces the door
        }
        --
        state "Keypad" as Keypad {
          [*] --> Idle
          Idle --> Typing : you press a key
          Typing --> Idle : you unlock the door
        }
      }
      Open --> Locked : you lock the door
      Open --> Locked : the timer locks the door
      Open --> Armed : you lock and arm
      Locked --> Open : you unlock the door
      Locked --> Locked : you reset the lock
      Ringing --> Open : someone opens the door
    }
    --
    state "Siren" as Siren {
      [*] --> Quiet
      Quiet --> Loud : someone forces the door [while the alarm is armed]
      %% when Armed
      Loud --> Quiet : you reset the lock
    }
  }
  [*] --> Front
  %% never NoRingingWhileOpen: Open & Ringing -- The alarm never rings while the door stands open.
  %% never NoCodeWhileOpen: Open & Typing -- The keypad holds no code while the door stands open.
