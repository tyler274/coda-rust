stateDiagram-v2
%% events declared
%% event open the panel | by you | You open the panel.
%% event close the panel | by you | You close it.
%% event {thing} loads | by the server | It shows.
%% event {thing} fails | by the server | It couldn't load; what was shown stays.
%% event retry {thing} | by you | needs Failed@{key}, Kept@{key} | reason: only a failed read retries | You read it again.
%% event the list is switched off | by the admin | needs Loading@list, Shown@list, Kept@list, Failed@list | reason: only a live list switches off | The list area goes away.
state Desk {
 state "Read" as ReadShape {
  %% shape read
  [*] --> Loading
  state "Loading {thing}" as Loading
  state "Showing {thing}" as Shown
  state "Showing {thing}, with Retry" as Kept
  state "Couldn't load {thing}, with Retry" as Failed
  Loading --> Shown : {thing} loads
  Shown --> Shown : {thing} loads
  Kept --> Shown : {thing} loads
  Loading --> Failed : {thing} fails
  Shown --> Kept : {thing} fails
  Failed --> Loading : retry {thing}
  Kept --> Loading : retry {thing}
  %% only note
 }
 state "The list read" as ListRead {
  %% use read as list: thing = the list
  state "Switched off" as Off
  Loading --> Off : the list is switched off
  Shown --> Off : the list is switched off
  Kept --> Off : the list is switched off
  Failed --> Off : the list is switched off
 }
 --
 state Panel {
  [*] --> Closed
  state Closed
  state "Panel open" as Open {
   [*] --> NoteRead
   state "The note read" as NoteRead {
    %% use read as note: thing = the note
   }
  }
  Closed --> Open : open the panel
  Open --> Closed : close the panel
 }
}
[*] --> Desk
