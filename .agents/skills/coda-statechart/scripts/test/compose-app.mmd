%% The patient's side of one connection, for the compose fixture.
%% events declared
%% event you're invited | by your practice | needs NNone | reason: only someone not connected is invited | Your practice invites you.
%% event join | by you | needs NInv | reason: only an invitation can be joined | You join your practice.
%% event save a note | by you | You save a note.
%% event new records arrive | by your records source | Your own sources deliver records.
state "Patient app" as App {
  state "Your practice" as Prac {
    [*] --> NNone
    state "Not connected" as NNone
    state "Invited" as NInv
    state "Connected" as NConn
    NNone --> NInv : you're invited
    NInv --> NConn : join
  }
  --
  state "Notes" as Notes {
    [*] --> None
    state "No note" as None
    state "Note" as Note
    None --> Note : save a note
    Note --> Note : save a note
    None --> None : new records arrive
  }
}
