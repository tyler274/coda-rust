[Unit]
Description=Loopback-only browser bridge for Coda engineering desktop
After=coda-desktop.service
Requires=coda-desktop.service
[Service]
Type=simple
User=@USER@
Group=@GROUP@
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 127.0.0.1:6080 127.0.0.1:5901
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
