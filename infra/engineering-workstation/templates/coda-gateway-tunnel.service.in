[Unit]
Description=Authenticated IAP connection to Coda shared gateway
StartLimitIntervalSec=0

[Service]
Type=simple
# Isolated CLI config selects the attached GCE identity, never the human's login.
Environment=CLOUDSDK_CONFIG=%h/.config/coda-gateway-gcloud
ExecStart=/snap/bin/gcloud compute start-iap-tunnel @GATEWAY@ 8765 --project=@PROJECT@ --zone=@ZONE@ --local-host-port=127.0.0.1:8765 --quiet
Restart=always
RestartSec=10
UMask=0077
