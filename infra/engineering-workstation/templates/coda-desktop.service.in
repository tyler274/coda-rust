[Unit]
Description=Coda engineering private desktop
After=network.target systemd-user-sessions.service
[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@HOME@
Environment=HOME=@HOME@
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
ExecStart=/usr/bin/tigervncserver :1 -fg -localhost yes -SecurityTypes VncAuth -rfbauth @HOME@/.vnc/passwd -geometry 1600x1000 -depth 24 -xstartup @HOME@/.vnc/xstartup
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
