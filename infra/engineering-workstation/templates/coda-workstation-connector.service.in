[Unit]
Description=Native Codex connector to Coda shared gateway
After=coda-codex-desktop.service coda-gateway-tunnel.service
Wants=coda-gateway-tunnel.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=%t/coda-desktop-session.env
WorkingDirectory=@HOME@/.local/share/coda-engineering/slack-bridge
ExecStart=@HOME@/.local/share/coda-engineering/slack-bridge/.venv/bin/python @HOME@/.local/share/coda-engineering/slack-bridge/workstation_connector.py --iap-port 8765
Restart=always
RestartSec=10
UMask=0077
Environment=PYTHONUNBUFFERED=1
