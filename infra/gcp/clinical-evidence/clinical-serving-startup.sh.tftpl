#!/bin/bash
# Compute Engine runs this startup-script as bash. The boot image provides
# /usr/local/bin/clinical-serving-startup; this file writes the rendered
# environment and execs that binary.
set -euo pipefail

cat > /etc/coda-clinical-serving.env <<'ENVIRONMENT'
%{ for name, value in environment ~}
${name}=${value}
%{ endfor ~}
ENVIRONMENT

exec /usr/local/bin/clinical-serving-startup \
  --data-root '${data_root}' \
  --image '${image}' \
  --env-file /etc/coda-clinical-serving.env
