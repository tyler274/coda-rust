stateDiagram-v2
  %% Email-link sign-in in detail, behind physician.mmd's Physician session. The Session
  %% region details the graph's session; the Page region is what one browser tab shows,
  %% which the graph does not model. sign-in.against.json maps it onto the graph, and
  %% statechart.mjs against checks it (README). The graph owns the behavior; this chart
  %% follows it.
  %% Decision: Dev 2026-10-24, clicking the email button signs in automatically, no code screen.
  %% Promise: only the server's successful verification opens the workspace. A request
  %% acknowledgement means check email, including unknown accounts; it never authenticates.
  %% Promise: the URL token is cleared before rendering; the server hashes, expires and
  %% consumes it once. These are data obligations, exercised in physician-auth and
  %% physician-sample/tests/site.rs, not represented as invented finite states here.
  %% Implementation: physician-app/src/lib.rs SignInScreen, PhysicianRoot and SessionState;
  %% tabs.rs carries sign-in news between this browser's tabs; main.rs sign_in_link.
  %% Browser tests cover the real mailed HTML button, public mount, reload, sign-out, an
  %% already-signed-in browser, reuse refusal, the expired prompt resuming in place (from the
  %% prompt and from another tab), another physician's sign-in, and No access. No chart safety
  %% rules: generation/check/trace establish transition correspondence, not data or runtime proof.
  %% Decision: Dev 2026-10-24, the emailed link carries no patient. A Coda link opened while
  %% signed out is held by the tab that opened it (Patient link). Signing in in any tab of this
  %% browser signs in its signed-out tabs, as sign-out reaches every tab, so the holding tab
  %% lands on its patient; the emailed link's own tab opens Today.
  %% events declared
  %% event request a link | by you | Enter an email or request a replacement link.
  %% event the request is acknowledged | by the authentication service | Check email; this does not reveal whether the account exists.
  %% event the request cannot be confirmed | by the authentication service or network | Show the failure or uncertainty; a message may still have arrived.
  %% event local proof returns a token | by the local proof transport | Test-only delivery uses the same verifier without a code screen.
  %% event use another email | by you | Return to the editable email field.
  %% event open the email button | by you | Navigate to the mailed link; clear URL credentials and attempt redemption once.
  %% event verification succeeds | by the authentication service | Store the issued session and open the workspace; this browser's signed-out tabs open too.
  %% event verification succeeds holding a patient link | by the authentication service | As verification succeeds, in a tab holding a Coda link: it lands on that patient by your access.
  %% event verification refuses access | by the authentication service | The link matched, but its account no longer has access to this practice.
  %% event verification refuses access holding a patient link | by the authentication service | As verification refuses access, in a tab holding a Coda link; the tab keeps holding it.
  %% event open a Coda link while signed out | by you | A Coda link to a patient opens the sign-in page; the tab holds the link.
  %% event verification fails or is uncertain | by the authentication service or network | Show a recovery action; never claim success or automatically resend.
  %% event reload with a valid session | by you | Restore the browser session through the existing authenticated read.
  %% event sign out | by you | End the server session and clear browser session storage.
  %% event reopen without a valid session | by you | Normal entry returns to the email field. Expiry during active work belongs to physician.mmd.
  %% event the session expires | by the authentication service | The server session ends; the page learns it on its next request or reopen.
  %% event access is removed | by the practice | A read finds this account's access removed; the page returns to sign-in.
  state "Sign-in" as SignIn {
    state "Session" as Session {
      [*] --> NoSession
      [*] --> Valid
      state "No session" as NoSession
      state "Session valid" as Valid
      state "Session ended" as Ended
      state "No access" as Refused
      NoSession --> Valid : verification succeeds [no patient link]
      %% when NoLink
      NoSession --> Valid : verification succeeds holding a patient link [holding a patient link]
      %% when HeldLink
      NoSession --> Refused : verification refuses access [no patient link]
      %% when NoLink
      NoSession --> Refused : verification refuses access holding a patient link [holding a patient link]
      %% when HeldLink
      Refused --> NoSession : use another email
      Refused --> Valid : verification succeeds [no patient link]
      %% when NoLink
      Refused --> Valid : verification succeeds holding a patient link [holding a patient link]
      %% when HeldLink
      Valid --> Valid : verification succeeds
      Valid --> NoSession : sign out
      Valid --> NoSession : access is removed
      Valid --> Ended : the session expires
      Ended --> Valid : verification succeeds
      Ended --> NoSession : sign out
      Ended --> NoSession : reopen without a valid session
      Ended --> NoSession : open the email button
    }
    --
    state "Page" as Page {
      [*] --> Entry
      [*] --> SigningIn
      [*] --> SignedIn
      state "Sign-in entry" as Entry {
        [*] --> Email
        state "Enter work email" as Email
        state "Sending link" as Requesting
        state "Check your email" as CheckEmail
        state "Signing you in" as SigningIn
        state "Sign-in recovery" as Recovery
        Email --> Requesting : request a link
        CheckEmail --> Requesting : request a link
        Recovery --> Requesting : request a link
        Requesting --> CheckEmail : the request is acknowledged
        Requesting --> Recovery : the request cannot be confirmed
        Requesting --> SigningIn : local proof returns a token
        CheckEmail --> Email : use another email
        Recovery --> Email : use another email
        state "No access to this practice" as NoAccess
        SigningIn --> Recovery : verification fails or is uncertain
        SigningIn --> NoAccess : verification refuses access
        SigningIn --> NoAccess : verification refuses access holding a patient link
        NoAccess --> Email : use another email
      }
      state "Workspace open" as SignedIn
      Entry --> SigningIn : open the email button
      SignedIn --> SigningIn : open the email button
      %% Verification in this tab or in another tab of this browser.
      Entry --> SignedIn : verification succeeds
      Entry --> SignedIn : verification succeeds holding a patient link
      Entry --> SignedIn : reload with a valid session [session valid]
      %% when Valid
      SignedIn --> SignedIn : reload with a valid session [session valid]
      %% when Valid
      Entry --> Email : reopen without a valid session [no valid session]
      %% when not Valid
      SignedIn --> Email : reopen without a valid session [no valid session]
      %% when not Valid
      SignedIn --> Email : sign out
      SignedIn --> Email : access is removed
      %% The prompt covers the open workspace and hides it; nothing underneath changes.
      state "Prompt over the workspace" as Covered {
        [*] --> PromptEmail
        state "Email me a sign-in link" as PromptEmail
        state "Sending the prompt's link" as PromptSending
        state "Check your email for the prompt's link" as PromptCheck
        state "Signing in under the prompt" as PromptSigning
        state "Prompt recovery" as PromptRecovery
        PromptEmail --> PromptSending : request a link
        PromptCheck --> PromptSending : request a link
        PromptRecovery --> PromptSending : request a link
        PromptSending --> PromptCheck : the request is acknowledged
        PromptSending --> PromptRecovery : the request cannot be confirmed
        PromptSending --> PromptSigning : local proof returns a token
        PromptSigning --> PromptRecovery : verification fails or is uncertain
      }
      SignedIn --> Covered : the session expires
      Covered --> SignedIn : verification succeeds
      Covered --> Email : sign out
      Covered --> Email : reopen without a valid session [no valid session]
      %% when not Valid
    }
    --
    %% What this tab was opening when it was signed out. The graph has no tabs: holding a link
    %% decides whether signing in is the graph's "sign in to the practice" or "sign in through a link".
    state "Patient link" as Link {
      [*] --> NoLink
      state "No patient link" as NoLink
      state "Holding a patient link" as HeldLink
      NoLink --> HeldLink : open a Coda link while signed out [no valid session]
      %% when not Valid
      HeldLink --> NoLink : verification succeeds holding a patient link
    }
  }
