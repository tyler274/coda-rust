stateDiagram-v2
  %% events declared
  %% event request a sign-in link | by you | Coda always answers "Check your email"; an address with no account gets no email (physician A1.2).
  %% event use another email | by you | Back to the email field.
  %% event open the email button | by you | The emailed link opens in this tab and signs you in with no code screen (physician A1.2).
  %% event verification succeeds | by Coda's sign-in service | needs SigningIn | This tab opens Today; the email carries no patient (physician A1.3).
  %% event the link was used or has expired | by Coda's sign-in service | needs SigningIn | The link is rejected (physician A1.5).
  %% event the link no longer grants access | by Coda's sign-in service | needs SigningIn | Shows "No access to this practice" (physician A1.2).
  %% event you sign in in another tab | by you | needs not SignedIn | Signing in anywhere in this browser signs this tab in too (physician A1.3).
  %% event the session expires | by Coda's sign-in service | needs SignedIn | A prompt covers your work (physician A1.3).
  %% event sign out | by you | needs not SignedOut | Sign-out works (physician A1.5).
  %% event open a patient link while signed out | by you | needs not SignedIn, SigningIn, Prompt | This tab holds the link while you sign in (physician A1.3).
  %% event close and reopen Coda | by you | Reopening without a session asks you to sign in (physician A1.3).
  %% event open another physician's sign-in link | by you | needs SignedIn | Signs you out and opens Today for them (physician A1.4).
  %% event open your own sign-in link | by you | needs SignedIn | Changes nothing (physician A1.4).
  state "Sign-in" as SignInJourney {
    state "This tab shows" as Page {
      [*] --> Email
      state "Enter your work email" as Email
      state "Check your email" as CheckEmail
      state "Signing you in" as SigningIn
      state "This link no longer works" as Rejected
      state "No access to this practice" as NoAccess
      state "Your workspace" as Workspace
      state "Sign-in prompt over your work" as Prompt
      Email --> CheckEmail : request a sign-in link
      Rejected --> CheckEmail : request a sign-in link
      Prompt --> Prompt : request a sign-in link
      CheckEmail --> Email : use another email
      NoAccess --> Email : use another email
      Email --> SigningIn : open the email button
      CheckEmail --> SigningIn : open the email button
      Workspace --> SigningIn : open another physician's sign-in link
      Workspace --> Workspace : open your own sign-in link
      SigningIn --> Workspace : verification succeeds
      SigningIn --> Rejected : the link was used or has expired
      SigningIn --> NoAccess : the link no longer grants access
      Email --> Workspace : you sign in in another tab
      CheckEmail --> Workspace : you sign in in another tab
      Prompt --> Workspace : you sign in in another tab
      Workspace --> Prompt : the session expires
      Workspace --> Email : sign out
      Prompt --> Email : sign out
      Prompt --> Email : close and reopen Coda
      CheckEmail --> Email : open a patient link while signed out
      Rejected --> Email : open a patient link while signed out
      NoAccess --> Email : open a patient link while signed out
    }
    --
    state "Your session" as Session {
      [*] --> SignedOut
      state "Signed out" as SignedOut
      state "Signed in" as SignedIn
      state "Session expired" as Expired
      SignedOut --> SignedIn : verification succeeds
      Expired --> SignedIn : verification succeeds
      SignedOut --> SignedIn : you sign in in another tab
      Expired --> SignedIn : you sign in in another tab
      SignedIn --> Expired : the session expires
      SignedIn --> SignedOut : sign out
      Expired --> SignedOut : sign out
      SignedIn --> SignedOut : open another physician's sign-in link
    }
    --
    state "A patient link this tab holds" as Link {
      [*] --> NoLink
      state "No patient link" as NoLink
      state "Holding a patient link" as Holding
      NoLink --> Holding : open a patient link while signed out
      Holding --> NoLink : you sign in in another tab
      Holding --> NoLink : open the email button
    }
    --
    state "Where the workspace opens" as Place {
      [*] --> Today
      state "Today" as Today
      state "The linked patient" as Patient
      Patient --> Today : verification succeeds
      Today --> Patient : you sign in in another tab [holding a patient link]
      %% when Holding
      Patient --> Today : sign out
      Patient --> Today : close and reopen Coda
    }
  }
  [*] --> SignInJourney
  %% never WorkspaceAfterSignOut: Your workspace & Signed out -- Sign-out works. (physician A1.5)
  %% never WorkspaceAfterExpiry: Your workspace & Session expired -- If the session expires mid-work, a sign-in prompt covers the screen. (physician A1.3)
  %% never PromptWhileSignedIn: Sign-in prompt over your work & Signed in -- After signing in the physician is exactly where they were. (physician A1.3)
  %% never HeldLinkLands: Your workspace & Holding a patient link -- A patient link opened while signed out lands that tab on the patient after sign-in. (physician A1.3)
