%% event open your phone's health data | by you | needs TabYou, TCur | reason: newer Terms wait first | Its connection, what it brought in, and its controls.
%% event open Settings | by you | needs DIn, AReady | reason: Settings stay reachable even before newer Terms, for exporting, deleting your account and withdrawing AI permission | Your name, AI, privacy, export, sign-out and deletion (ui-surface-map.md, Settings).
%% event open AI settings | by you | needs DIn, AReady | reason: AI settings stay reachable even before newer Terms, for withdrawing permission | Your AI permission, the AI switch, and proactive work.
%% event go back on You | by you | needs TabYou | reason: only the tab you're on goes back | You return to your health library; nothing you had saved changes. How far back goes is presentation.
%% events you open something on Today = open an insight | open a measurement on Today | choose Today's measurements | open your Plan | open the Reminder | open the Check-in | open For my doctor | open your doctor's plan
%% events you open a page on You = open a records group | open a record | open Measurements & trends | open a measurement in You | open Health history | open Earlier insights | search your health | open Sources & data | open Doctors & hospitals | open your phone's health data | open Settings | open AI settings
%% event open supporting information | by you | needs TabDuet, TCur | reason: citations are in the conversation; newer Terms wait first | The exact version of what a reply cited, never a newer one in its place (C6; ui-surface-map.md, cited source).
%% event close the supporting information | by you | needs CoSource | reason: only open supporting information closes | You're back in the conversation where you were.
%% event {read} shows a saved copy | by the app | needs RdLoading@{key} | reason: only a read in progress shows a saved copy | What you saw last appears at once and refreshes quietly; loading shows only when nothing can.
%% event {read} loads | by Duet | A first read shows; a refresh updates what is shown in place, and an empty answer never replaces it.
%% event {read} loads in part | by Duet | What loaded shows with one quiet line and Retry; never read as empty.
%% event {read} fails to load | by Duet | What was shown stays with one quiet line and Retry; with nothing shown, it says it couldn't load, with Retry. Never a false empty state.
%% event retry {read} | by you | needs DIn, RdKept@{key}, RdFailed@{key} | reason: only a read that shows a problem offers Retry | You read it again; what is shown stays.
%% event the supporting information loads with a newer version | by Duet | needs RdLoading@source | reason: only supporting information being read loads | The exact cited version shows, with a note that a newer version exists (E5).
%% events your shared data changes = new records arrive | a record is corrected | clinical records arrive from your phone's health app | a clinical record changes in your phone's health app | your phone's readings arrive | a reading is deleted in your phone's health app | you answer a Check-in about your doctor's plan | add a note | change the note | delete the note | save the proposed note | add a medication | confirm a medication from your records | change the medication | mark the medication stopped | delete the medication | Duet saves a note as you asked | Duet changes the note as you asked | Duet deletes the note as you asked | Duet saves the proposed note as you asked | Duet adds a medication as you asked | Duet confirms a medication from your records as you asked | Duet changes the medication as you asked | Duet marks the medication stopped as you asked | Duet deletes the medication as you asked

  state "Duet" as App {

    %% Your account lives with Duet, not with a device. Setup runs once per account: Terms, a
    %% name only if the sign-in brought none, then the AI choice (north-star.md steps 1-4).
    state "Your account" as Acct {
      [*] --> ANone
      state "No account" as ANone
      state "Agreeing to the Terms" as AAgree
      state "Choosing a display name" as AName
      state "Choosing about AI" as AChoose
      state "Deleting your account" as ADeleting
      %% Set up: everything below belongs to the account and outlives any one device.
      state "Set up" as AReady {
        state "AI permission" as Permit {
          [*] --> PNot
          [*] --> PAllowed : allow AI
          state "AI allowed" as PAllowed
          state "AI not allowed" as PNot
          state "Newer AI permission to allow" as PNew
          PNot --> PAllowed : allow AI in settings
          PAllowed --> PNot : withdraw AI permission
          PAllowed --> PNew : Duet publishes a new AI permission
          PNew --> PAllowed : allow the new AI permission
          PNew --> PNot : withdraw AI permission
        }
        --
        state "AI switch" as Switch {
          [*] --> SwOn
          state "AI on" as SwOn
          state "AI off" as SwOff
          SwOn --> SwOff : turn AI off
          SwOff --> SwOn : turn AI on
        }
        --
        state "Proactive work" as Proactive {
          [*] --> PwOn
          state "Proactive work on" as PwOn
          state "Proactive work paused" as PwPaused
          PwOn --> PwPaused : pause proactive work
          PwPaused --> PwOn : resume proactive work
        }
        --
        state "Terms" as Terms {
          [*] --> TCur
          state "Current Terms accepted" as TCur
          state "Newer Terms to accept" as TNew
          TCur --> TNew : Duet publishes new Terms
          TNew --> TCur : accept the new Terms
        }
        --
        %% Your latest message on its way. Once you send it, it belongs to your account, not the
        %% device: signing out doesn't drop it (Dev 2026-10-25). Its words are never lost: only a
        %% definite refusal returns them to you, and an unconfirmed send stays honest until known.
        state "Your latest message" as Out {
          [*] --> OIdle
          state "Nothing on its way" as OIdle
          state "Sending" as OSending
          state "Not confirmed yet" as OUnsure
          state "Not sent, with Try again and Edit" as OUnsent
          state "Sent" as OSent
          OIdle --> OSending : send your message
          OSent --> OSending : send your message
          OUnsure --> OSending : send your message
          OUnsent --> OSending : send your message
          OSending --> OSent : Duet receives your message
          OUnsure --> OSent : Duet receives your message
          OSending --> OUnsure : your message isn't confirmed
          OSending --> OUnsent : Duet refuses your message
          OUnsure --> OSending : try sending again
          OUnsent --> OSending : try sending again
          OUnsent --> OIdle : edit the unsent message
        }
        --
        %% Duet's reply lives with the account: it keeps going whichever device you're on.
        %% Writing needs AI allowed, on and current Terms; the switch and Terms pause it without
        %% using it up, and withdrawn permission ends it for good (D7, F3). A message that arrives
        %% while AI is unavailable is never left unanswered: its reply waits paused, or ends.
        state "Duet's reply" as Reply {
          [*] --> RIdle
          state "No reply in progress" as RIdle
          state "Duet is writing" as RWriting
          state "Reply paused" as RPaused
          state "Reply unfinished, with Try again" as RUnfinished
          state "Reply ended when AI permission was withdrawn" as REnded
          state "Reply finished" as RDone {
            %% Your feedback on the reply: only on a finished reply, and only yours to see.
              [*] --> FbNone
              state "No feedback" as FbNone
              state "Helpful" as FbUp
              state "Not helpful" as FbDown
              FbDown --> FbDown : save the details
              FbNone --> FbUp : mark the reply helpful
              FbDown --> FbUp : mark the reply helpful
              FbNone --> FbDown : mark the reply not helpful
              FbUp --> FbDown : mark the reply not helpful
              FbUp --> FbNone : remove your feedback
              FbDown --> FbNone : remove your feedback
          }
          RIdle --> RWriting : Duet receives your message [AI allowed, on, current Terms]
          %% when PAllowed, SwOn, TCur | reason: Duet's AI needs your permission, the switch on and current Terms (F3)
          RDone --> RWriting : Duet receives your message [AI allowed, on, current Terms]
          %% when PAllowed, SwOn, TCur | reason: Duet's AI needs your permission, the switch on and current Terms (F3)
          RUnfinished --> RWriting : Duet receives your message [AI allowed, on, current Terms]
          %% when PAllowed, SwOn, TCur | reason: Duet's AI needs your permission, the switch on and current Terms (F3)
          REnded --> RWriting : Duet receives your message [AI allowed, on, current Terms]
          %% when PAllowed, SwOn, TCur | reason: Duet's AI needs your permission, the switch on and current Terms (F3)
          RIdle --> RPaused : Duet receives your message [AI off]
          %% when PAllowed, SwOff | reason: the switch pauses AI work without using it up (D7)
          RIdle --> RPaused : Duet receives your message [newer Terms]
          %% when PAllowed, SwOn, TNew | reason: newer Terms pause AI work without using it up (D7)
          RIdle --> RPaused : Duet receives your message [newer AI permission]
          %% when PNew | reason: a newer AI permission pauses AI work without using it up (Dev 2026-10-25)
          RIdle --> REnded : Duet receives your message [AI not allowed]
          %% when PNot | reason: no AI work without your permission; the reply shows unfinished without Try again (F3; Oct 4 rule 7)
          RDone --> RPaused : Duet receives your message [AI off]
          %% when PAllowed, SwOff | reason: the switch pauses AI work without using it up (D7)
          RDone --> RPaused : Duet receives your message [newer Terms]
          %% when PAllowed, SwOn, TNew | reason: newer Terms pause AI work without using it up (D7)
          RDone --> RPaused : Duet receives your message [newer AI permission]
          %% when PNew | reason: a newer AI permission pauses AI work without using it up (Dev 2026-10-25)
          RDone --> REnded : Duet receives your message [AI not allowed]
          %% when PNot | reason: no AI work without your permission; the reply shows unfinished without Try again (F3; Oct 4 rule 7)
          RUnfinished --> RPaused : Duet receives your message [AI off]
          %% when PAllowed, SwOff | reason: the switch pauses AI work without using it up (D7)
          RUnfinished --> RPaused : Duet receives your message [newer Terms]
          %% when PAllowed, SwOn, TNew | reason: newer Terms pause AI work without using it up (D7)
          RUnfinished --> RPaused : Duet receives your message [newer AI permission]
          %% when PNew | reason: a newer AI permission pauses AI work without using it up (Dev 2026-10-25)
          RUnfinished --> REnded : Duet receives your message [AI not allowed]
          %% when PNot | reason: no AI work without your permission; the reply shows unfinished without Try again (F3; Oct 4 rule 7)
          REnded --> RPaused : Duet receives your message [AI off]
          %% when PAllowed, SwOff | reason: the switch pauses AI work without using it up (D7)
          REnded --> RPaused : Duet receives your message [newer Terms]
          %% when PAllowed, SwOn, TNew | reason: newer Terms pause AI work without using it up (D7)
          REnded --> RPaused : Duet receives your message [newer AI permission]
          %% when PNew | reason: a newer AI permission pauses AI work without using it up (Dev 2026-10-25)
          RWriting --> RWriting : Duet receives your message [steers the reply]
          %% when PAllowed, SwOn, TCur | reason: Duet's AI needs your permission, the switch on and current Terms (F3)
          RWriting --> RWriting : you or your sources change what Duet read / looks again at the reply
          RPaused --> RPaused : you or your sources change what Duet read / looks again at the reply
          RWriting --> RDone : Duet finishes the reply
          RWriting --> RUnfinished : the reply can't finish
          RUnfinished --> RWriting : try the reply again
          RWriting --> RPaused : turn AI off
          RWriting --> RPaused : Duet publishes new Terms
          RWriting --> RPaused : Duet publishes a new AI permission
          RPaused --> RWriting : turn AI on [current Terms and AI permission]
          %% when TCur, PAllowed | reason: newer Terms or a newer AI permission still pause AI work
          RPaused --> RWriting : accept the new Terms [AI on, current AI permission]
          %% when SwOn, PAllowed | reason: the switch or a newer AI permission still pause AI work
          RPaused --> RWriting : allow the new AI permission [AI on]
          %% when SwOn | reason: the switch still pauses AI work
          RWriting --> REnded : withdraw AI permission
          RPaused --> REnded : withdraw AI permission
        }
        --
        %% Whether the reply in progress read your latest edits to For my doctor and your appointment. Duet's own saves
        %% happen inside the reply, so only yours count; a new message or a fresh look reads them again.
        state "What the reply read" as RRead {
          [*] --> RrLatest
          state "The reply read your latest edits" as RrLatest
          state "You edited since the reply read" as RrBehind
          RrLatest --> RrBehind : you change For my doctor or your appointment
          RrLatest --> RrBehind : save the update for your doctor
          RrBehind --> RrLatest : Duet receives your message
          RrBehind --> RrLatest : try the reply again
          RrBehind --> RrLatest : you or your sources change what Duet read
        }
        --
        %% The fixed safety line (Dev 2026-10-25): once Duet's AI sees a possible emergency or
        %% self-harm, the reply carries the fixed line however it ends, unchanged and without a
        %% judgment of severity (north-star.md, September 23 rule).
        state "Fixed safety line" as Safety {
          [*] --> SlNone
          state "No safety line owed" as SlNone
          state "Safety line owed in this reply" as SlOwed
          state "Safety line shown" as SlShown
          SlNone --> SlOwed : Duet's AI sees a possible emergency or self-harm
          SlShown --> SlOwed : Duet's AI sees a possible emergency or self-harm
          SlOwed --> SlShown : Duet finishes the reply
          SlOwed --> SlShown : the reply can't finish
          SlOwed --> SlShown : withdraw AI permission
          SlOwed --> SlShown : turn AI off
          SlOwed --> SlShown : Duet publishes new Terms
          SlOwed --> SlShown : Duet publishes a new AI permission
          SlShown --> SlOwed : try the reply again
          SlShown --> SlNone : Duet receives your message [starts a new reply]
          %% when not RWriting, RPaused | reason: a steer belongs to the reply in progress, writing or paused
        }
        --
        %% The thread (Dev 2026-10-26): Duet is thread and message first. Whatever Duet says, it says as a
        %% message in the conversation, and Today pins what matters from it. Whether something new waits
        %% unseen is one fact for your account, whichever device you read it on.
        state "The thread" as Thread {
          [*] --> ThSeen
          state "Nothing new from Duet" as ThSeen
          state "A new message from Duet, unseen" as ThUnseen
          ThSeen --> ThUnseen : Duet posts in the thread
          ThSeen --> ThUnseen : Duet has something to tell you [unless Duet is writing]
          %% when not RWriting | reason: while Duet writes, its own message waits for the reply to end (Dev 2026-10-26)
          ThSeen --> ThUnseen : Duet stops writing early [with a message waiting]
          %% when OmWaiting | reason: a reply that stops posts what was waiting for it
          ThUnseen --> ThSeen : you see the new messages
          ThUnseen --> ThSeen : you see the new messages on another device
        }
        --
        %% What Duet has to tell you on its own (Dev 2026-10-26): what its own work noticed, a proposed note,
        %% a Reminder, a Check-in or its failure, your practice's news. It posts at once, unless Duet is replying to you: then it waits and posts right
        %% after the reply ends, however it ends. Your message steers the reply and goes ahead of it. With
        %% AI unavailable, a Reminder posts your words and your practice's news posts as fixed product text.
        state "Duet's own message" as OwnMsg {
          [*] --> OmNone
          state "Nothing waiting to post" as OmNone
          %% Whether anything you asked for or your practice's news is among what waits decides whether
          %% it alerts without your switch for Duet's own work (north-star.md, Notifications; Dev 2026-10-26).
          state "A message waiting for the reply to end" as OmWaiting {
            [*] --> OmOwn
            state "Only Duet's own message waiting" as OmOwn
            state "What you asked for or your practice's news waiting" as OmAsked
            OmOwn --> OmAsked : Duet tells you what you asked for or your practice's news
          }
          OmNone --> OmOwn : Duet noticed something on its own [while Duet is writing]
          %% when RWriting | reason: Duet's own messages never cut into a reply (Dev 2026-10-26)
          OmNone --> OmAsked : Duet tells you what you asked for or your practice's news [while Duet is writing]
          %% when RWriting | reason: Duet's own messages never cut into a reply (Dev 2026-10-26)
          OmWaiting --> OmNone : Duet posts in the thread
          OmWaiting --> OmNone : Duet stops writing early
          %% never WaitsOnlyWhileWriting: A message waiting for the reply to end & No reply in progress -- A message waits only for a reply being written.
          %% never WaitsNotAfterFinish: A message waiting for the reply to end & Reply finished -- A finished reply posts what waited.
          %% never WaitsNotAfterFailure: A message waiting for the reply to end & Reply unfinished, with Try again -- A reply that can't finish posts what waited.
          %% never WaitsNotWhilePaused: A message waiting for the reply to end & Reply paused -- A paused reply posts what waited.
        }
        --
        %% One switch for alerts about what Duet noticed from its own work, saved with your account (Dev 2026-10-26).
        state "Alerts for Duet's own work" as InsAlerts {
          [*] --> IaOff
          state "Duet's own work doesn't alert you" as IaOff
          state "Duet's own work alerts you" as IaOn
          IaOff --> IaOn : turn on alerts for Duet's own work
          IaOn --> IaOff : turn off alerts for Duet's own work
        }
        --
        %% One saved item per kind stands for each of its kind; each behaves the same way.
        state "{Kind}" as Fu {
          %% template
          %% instance reminder: kind = Reminder, Kind = Reminder, due = FuSched@reminder, run = FuSched@reminder, stuck = FuSched@reminder
          %% instance checkin: kind = Check-in, Kind = Check-in, due = FuDue@checkin, run = FuRun@checkin, stuck = FuStuck@checkin
          [*] --> FuNone
          state "No {kind}" as FuNone
          %% Scheduled: waiting for its next time, whether or not its last run failed. What happens
          %% at a scheduled time, and your pause, change or cancel, apply the same either way.
          state "{Kind} scheduled" as FuSched {
            [*] --> FuActive
            state "{Kind} active" as FuActive
            state "Check-in couldn't finish, with Try again" as FuStuck
            %% only checkin
          }
          state "{Kind} due" as FuDue
          %% only checkin
          state "Check-in running" as FuRun
          %% only checkin
          state "{Kind} paused" as FuPaused {
            [*] --> FuPausedYou
            state "{Kind} paused by you" as FuPausedYou
            state "Check-in paused after failing repeatedly" as FuHalted
            %% only checkin
          }
          state "{Kind} completed" as FuDone
          state "{Kind} cancelled" as FuCancelled
          FuNone --> FuActive : Duet saves the {kind} you asked for
          FuDone --> FuActive : Duet saves the {kind} you asked for
          FuCancelled --> FuActive : Duet saves the {kind} you asked for
          FuSched --> FuDue : the {kind} comes due [AI allowed, on, current Terms, proactive work on]
          %% when PAllowed, SwOn, TCur, PwOn | reason: Duet delivers only while you allow it, AI is on, Terms are current and proactive work is on (F3, D7)
          %% only checkin
          FuSched --> FuActive : the {kind} comes due [newer AI permission, a later time remains]
          %% when PNew | reason: a time that comes while a newer AI permission waits passes undelivered (Dev 2026-10-25)
          %% only checkin
          FuSched --> FuDone : the {kind} comes due [newer AI permission, its last time]
          %% when PNew | reason: a time that comes while a newer AI permission waits passes undelivered (Dev 2026-10-25)
          %% only checkin
          FuSched --> FuActive : the {kind} comes due [AI not allowed, a later time remains]
          %% when PNot | reason: a time that comes while AI permission is withdrawn passes undelivered (F3)
          FuSched --> FuDone : the {kind} comes due [AI not allowed, its last time]
          %% when PNot | reason: a time that comes while AI permission is withdrawn passes undelivered (F3)
          FuSched --> FuActive : the {kind} comes due [AI off, a later time remains]
          %% when PAllowed, SwOff | reason: a time that comes while AI is off passes undelivered (Dev 2026-10-25)
          %% only checkin
          FuSched --> FuDone : the {kind} comes due [AI off, its last time]
          %% when PAllowed, SwOff | reason: a time that comes while AI is off passes undelivered (Dev 2026-10-25)
          %% only checkin
          FuSched --> FuActive : the {kind} comes due [newer Terms, a later time remains]
          %% when PAllowed, SwOn, TNew | reason: a time that comes while newer Terms wait passes undelivered (Dev 2026-10-25)
          %% only checkin
          FuSched --> FuDone : the {kind} comes due [newer Terms, its last time]
          %% when PAllowed, SwOn, TNew | reason: a time that comes while newer Terms wait passes undelivered (Dev 2026-10-25)
          %% only checkin
          FuSched --> FuActive : the {kind} comes due [proactive work paused, a later time remains]
          %% when PAllowed, SwOn, TCur, PwPaused | reason: a time that comes while proactive work is paused passes undelivered (Dev 2026-10-25)
          FuSched --> FuDone : the {kind} comes due [proactive work paused, its last time]
          %% when PAllowed, SwOn, TCur, PwPaused | reason: a time that comes while proactive work is paused passes undelivered (Dev 2026-10-25)
          FuSched --> FuActive : the {kind} comes due [newer AI permission, proactive work paused, a later time remains]
          %% when PNew, PwPaused | reason: a time that comes while proactive work is paused passes undelivered (Dev 2026-10-25)
          %% only reminder
          FuSched --> FuDone : the {kind} comes due [newer AI permission, proactive work paused, its last time]
          %% when PNew, PwPaused | reason: a time that comes while proactive work is paused passes undelivered (Dev 2026-10-25)
          %% only reminder
          FuSched --> FuActive : the {kind} comes due [AI off, proactive work paused, a later time remains]
          %% when PAllowed, SwOff, PwPaused | reason: a time that comes while proactive work is paused passes undelivered (Dev 2026-10-25)
          %% only reminder
          FuSched --> FuDone : the {kind} comes due [AI off, proactive work paused, its last time]
          %% when PAllowed, SwOff, PwPaused | reason: a time that comes while proactive work is paused passes undelivered (Dev 2026-10-25)
          %% only reminder
          FuSched --> FuActive : the {kind} comes due [newer Terms, proactive work paused, a later time remains]
          %% when PAllowed, SwOn, TNew, PwPaused | reason: a time that comes while proactive work is paused passes undelivered (Dev 2026-10-25)
          %% only reminder
          FuSched --> FuDone : the {kind} comes due [newer Terms, proactive work paused, its last time]
          %% when PAllowed, SwOn, TNew, PwPaused | reason: a time that comes while proactive work is paused passes undelivered (Dev 2026-10-25)
          %% only reminder
          FuRun --> FuStuck : the Check-in can't finish
          %% only checkin
          FuRun --> FuHalted : the Check-in keeps failing
          %% only checkin
          FuStuck --> FuRun : try the Check-in again
          %% only checkin
          FuDue --> FuRun : Duet starts the Check-in
          %% only checkin
          FuRun --> FuActive : Duet delivers the Check-in
          %% only checkin
          FuRun --> FuDone : Duet delivers the Check-in
          %% only checkin
          FuSched --> FuActive : Duet delivers the Reminder
          %% only reminder
          FuSched --> FuDone : Duet delivers the Reminder
          %% only reminder
          FuRun --> FuDue : proactive AI work pauses
          %% only checkin
          FuRun --> FuDue : what Duet read changes
          %% only checkin
          FuRun --> FuDue : Duet receives your message / may look again at the Check-in
          %% only checkin
          FuRun --> FuActive : withdraw AI permission
          %% only checkin
          FuRun --> FuDone : withdraw AI permission
          %% only checkin
          FuStuck --> FuActive : withdraw AI permission
          %% only checkin
          FuStuck --> FuDone : withdraw AI permission
          %% only checkin
          FuDue --> FuActive : withdraw AI permission
          %% only checkin
          FuDue --> FuDone : withdraw AI permission
          %% only checkin
          FuSched --> FuPaused : pause the {kind}
          FuDue --> FuPaused : pause the {kind}
          %% only checkin
          FuRun --> FuPaused : pause the {kind}
          %% only checkin
          FuPaused --> FuActive : resume the {kind}
          FuSched --> FuActive : change the {kind}
          FuDue --> FuActive : change the {kind}
          %% only checkin
          FuRun --> FuActive : change the {kind}
          %% only checkin
          FuPausedYou --> FuPausedYou : change the {kind}
          FuHalted --> FuHalted : change the {kind}
          %% only checkin
          FuSched --> FuCancelled : cancel the {kind}
          FuDue --> FuCancelled : cancel the {kind}
          %% only checkin
          FuRun --> FuCancelled : cancel the {kind}
          %% only checkin
          FuPaused --> FuCancelled : cancel the {kind}
          FuSched --> FuActive : Duet changes the {kind} as you asked
          FuDue --> FuActive : Duet changes the {kind} as you asked
          %% only checkin
          FuRun --> FuActive : Duet changes the {kind} as you asked
          %% only checkin
          FuPausedYou --> FuPausedYou : Duet changes the {kind} as you asked
          FuHalted --> FuHalted : Duet changes the {kind} as you asked
          %% only checkin
          FuSched --> FuPaused : Duet pauses the {kind} as you asked
          FuDue --> FuPaused : Duet pauses the {kind} as you asked
          %% only checkin
          FuRun --> FuPaused : Duet pauses the {kind} as you asked
          %% only checkin
          FuSched --> FuCancelled : Duet cancels the {kind} as you asked
          FuDue --> FuCancelled : Duet cancels the {kind} as you asked
          %% only checkin
          FuRun --> FuCancelled : Duet cancels the {kind} as you asked
          %% only checkin
          FuPaused --> FuCancelled : Duet cancels the {kind} as you asked
        }
        --
        state "Your Plan" as Plan {
          [*] --> PlNone
          state "No Plan" as PlNone
          state "Plan saved" as PlSaved
          PlNone --> PlSaved : Duet saves the Plan you asked for
          PlSaved --> PlSaved : Duet saves the Plan you asked for
          PlSaved --> PlSaved : change the Plan
          PlSaved --> PlNone : delete the Plan
          PlSaved --> PlNone : Duet deletes the Plan as you asked
        }
        --
        %% Which Plan a Reminder or Check-in serves (Dev 2026-09-28; kept 2026-10-26): a thin link to at
        %% most one Plan. Duet's AI sets or clears it when your request serves that Plan, and you change it
        %% in conversation. Deleting the Plan leaves the follow-up running, unlinked. A Plan shows no progress.
        state "{Kind}: its Plan" as Lk {
          %% template
          %% instance reminder: kind = Reminder, Kind = Reminder
          %% instance checkin: kind = Check-in, Kind = Check-in
          [*] --> LkNone
          state "{Kind} serves no Plan" as LkNone
          state "{Kind} serves your Plan" as LkPlan
          LkNone --> LkPlan : Duet links the {kind} to your Plan as you asked
          LkPlan --> LkNone : Duet unlinks the {kind} from your Plan as you asked
          LkPlan --> LkNone : delete the Plan
          LkPlan --> LkNone : Duet deletes the Plan as you asked
          LkPlan --> LkNone : Duet saves the {kind} you asked for [a new {kind}]
          %% when FuNone@{key}, FuDone@{key}, FuCancelled@{key} | reason: a new {kind} replaces a finished one and starts unlinked
          %% never LinkWithoutPlan: {Kind} serves your Plan & No Plan -- A {kind} serves only a saved Plan (Dev 2026-09-28).
        }
        --
        %% Your export (ENG-161, journey D5): everything Duet keeps about you, prepared on request. Deleting
        %% your account ends it with everything else.
        state "Your export" as Ex {
          [*] --> ExNone
          state "No export" as ExNone
