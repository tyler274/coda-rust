          state "Showing {read}" as RdShown
          state "Showing {read}, with one quiet line and Retry" as RdKept
          state "Couldn't load {read}, with Retry" as RdFailed
          RdLoading --> RdShown : {read} shows a saved copy
          RdLoading --> RdShown : {read} loads
          RdShown --> RdShown : {read} loads
          RdKept --> RdShown : {read} loads
          RdLoading --> RdKept : {read} loads in part
          RdShown --> RdKept : {read} loads in part
          RdLoading --> RdFailed : {read} fails to load
          RdShown --> RdKept : {read} fails to load
          RdKept --> RdKept : retry {read}
          RdFailed --> RdLoading : retry {read}
        }
      }
      DOut --> DIn : sign in
      DIn --> DOut : sign out on this device
      DIn --> DOut : sign out everywhere
      DIn --> DOut : the deletion finishes
    }
    --
    %% Your other devices, together: only what sign-out everywhere and deletion change.
    state "Your other devices" as Others {
      [*] --> ODOut
      state "No other device signed in" as ODOut
      state "Signed in on another device" as ODIn
      ODOut --> ODIn : sign in on another device
      ODIn --> ODOut : sign out on another device
      ODIn --> ODOut : sign out everywhere
      ODIn --> ODOut : the deletion finishes
    }
    --
    %% Whether Duet is on this device's screen or in the background: what you can see right now.
    state "Duet on this device" as AppVis {
      [*] --> AppFront
      state "Duet on screen" as AppFront
      state "Duet in the background" as AppBack
      AppFront --> AppBack : leave Duet
      AppBack --> AppFront : open Duet
      AppBack --> AppFront : open the notification
    }
    --
    %% This device's own alert permission: it belongs to the device, not the session (north-star.md, Notifications).
    state "This device's alerts" as Alerts {
      [*] --> NtAsk
      state "Duet hasn't asked for alerts yet" as NtAsk
      state "Alerts allowed on this device" as NtOn
      state "Alerts not allowed on this device" as NtOff
      NtAsk --> NtOn : allow alerts
      NtAsk --> NtOff : don't allow alerts
      NtOn --> NtOff : turn alerts off in your device's settings
      NtOff --> NtOn : turn alerts on in your device's settings
    }
    --
    %% What waits on this device's lock screen: at most one notification stands for every message since you last
    %% saw the thread. Only the signed-in account's alerts wait here, so a shared device alerts for whoever is
    %% signed in; signing out or deleting clears it. Seeing the messages on any device clears it (Dev 2026-10-26).
    state "Notification on this device" as Notice {
      [*] --> NoNone
      state "No notification waiting" as NoNone
      state "A notification from Duet waiting" as NoWaiting
      NoNone --> NoWaiting : Duet posts in the thread [you're away, alerts allowed]
      %% when AppBack, NtOn, DIn | reason: a reply alerts like a text, only while you're away and this device allows alerts (Dev 2026-10-26)
      NoNone --> NoWaiting : Duet tells you what you asked for or your practice's news [you're away, alerts allowed, not mid-reply]
      %% when AppBack, NtOn, DIn, RIdle, RPaused, RUnfinished, REnded, RDone | reason: what you asked for and your practice's news alert wherever alerts are allowed; while Duet writes it waits for the reply (Dev 2026-10-26)
      NoNone --> NoWaiting : Duet noticed something on its own [you're away, alerts allowed, your switch on, not mid-reply]
      %% when AppBack, NtOn, DIn, IaOn, RIdle, RPaused, RUnfinished, REnded, RDone | reason: what Duet noticed or offers on its own alerts only once you turn it on (north-star.md, Notifications; Dev 2026-10-26)
      NoNone --> NoWaiting : Duet stops writing early [with what you asked for or your practice's news waiting, you're away, alerts allowed]
      %% when OmAsked, AppBack, NtOn, DIn | reason: a reply that stops posts what waited, and what you asked for and your practice's news alert wherever alerts are allowed (Dev 2026-10-26)
      NoNone --> NoWaiting : Duet stops writing early [with only Duet's own message waiting, you're away, alerts allowed, your switch on]
      %% when OmOwn, AppBack, NtOn, DIn, IaOn | reason: what Duet noticed on its own alerts only once you turn it on (north-star.md, Notifications; Dev 2026-10-26)
      NoWaiting --> NoNone : open the notification
      NoWaiting --> NoNone : you see the new messages
      NoWaiting --> NoNone : you see the new messages on another device
      NoWaiting --> NoNone : turn alerts off in your device's settings
      NoWaiting --> NoNone : sign out on this device
      NoWaiting --> NoNone : sign out everywhere
      NoWaiting --> NoNone : the deletion finishes
      %% never NoticeOnlySignedIn: A notification from Duet waiting & Signed out on this device -- Only the signed-in account's alerts wait on this device (Dev 2026-10-26).
      %% never NoticeOnlyWithAlerts: A notification from Duet waiting & Alerts not allowed on this device -- Turning alerts off ends what this device was owed (north-star.md, Notifications).
      %% never NoticeOnlyAfterAsking: A notification from Duet waiting & Duet hasn't asked for alerts yet -- Duet alerts only after you allow it.
    }
    --
    %% Your practice: the connection is yours and the practice's, not a device's. Connected means
    %% sharing; there is no stop or resume in the MVP (ENG-70). Duet's AI never shares anything:
    %% what flows is what you connected (ENG-39). For my doctor goes only when you send it.
    state "Your practice" as Prc {
      [*] --> PrcNone
      state "No practice connection" as PrcNone
      state "A practice's invitation waits for you" as PrcInvited
      state "Connected to your practice, sharing" as PrcConn
      state "Connection ended" as PrcEnded {
        [*] --> PrcLeft
        state "You left your practice" as PrcLeft
        state "Your practice ended the connection, with a dated notice" as PrcDischarged
      }
      PrcNone --> PrcInvited : your practice's invitation reaches you
      PrcInvited --> PrcInvited : your practice's invitation reaches you
      PrcEnded --> PrcInvited : your practice's invitation reaches you
      PrcInvited --> PrcNone : your practice's invitation ends
      PrcInvited --> PrcConn : join your practice
      PrcConn --> PrcConn : your shared data changes
      PrcConn --> PrcLeft : leave your practice
      PrcConn --> PrcDischarged : your practice discharges you
      PrcInvited --> PrcNone : delete your account
      PrcConn --> PrcNone : delete your account
      PrcEnded --> PrcNone : delete your account
    }
    --
    %% What you have from your sources: kept through any disconnect, gone only with your account (F1, F2).
    state "Your health records" as Rec {
      [*] --> RecNone
      state "No records yet" as RecNone
      state "Records kept" as RecHave
      RecNone --> RecHave : records come in
      RecNone --> RecHave : your phone's readings arrive
      RecHave --> RecNone : the deletion finishes
    }
    --
    state "Doctors & hospitals: an organization" as Org {
      [*] --> OrgOff
      state "Organization not connected" as OrgOff
      state "Signing in at the organization's portal" as OrgSigning
      state "Organization connected" as OrgConn {
        [*] --> OrgImporting
        state "Importing your records" as OrgImporting
        state "Up to date" as OrgCurrent
        state "Up to date except items it couldn't read, named" as OrgPartial
        state "Couldn't update; your records stay, and the next refresh tries again" as OrgTrouble
        state "Couldn't update since its last import, with Reconnect" as OrgSignIn
        state "Signing in again at the portal" as OrgResigning
        OrgImporting --> OrgCurrent : the import finishes
        OrgImporting --> OrgPartial : the import finishes with items it couldn't read
        OrgImporting --> OrgTrouble : the import can't finish
        OrgCurrent --> OrgImporting : refresh your records
        OrgPartial --> OrgImporting : refresh your records
        OrgTrouble --> OrgImporting : refresh your records
        OrgCurrent --> OrgImporting : your records refresh on their own
        OrgPartial --> OrgImporting : your records refresh on their own
        OrgTrouble --> OrgImporting : your records refresh on their own
        OrgSignIn --> OrgResigning : reconnect the organization
        OrgResigning --> OrgImporting : the portal signs you in
        OrgResigning --> OrgSignIn : cancel the portal sign-in
        OrgResigning --> OrgSignIn : the portal sign-in fails
      }
      OrgOff --> OrgSigning : connect a doctor or hospital
      OrgSigning --> OrgConn : the portal signs you in
      OrgSigning --> OrgOff : cancel the portal sign-in
      OrgSigning --> OrgOff : the portal sign-in fails
      OrgConn --> OrgSignIn : the organization stops accepting Duet's access
      OrgConn --> OrgOff : disconnect the organization
      OrgSigning --> OrgOff : delete your account
      OrgConn --> OrgOff : delete your account
    }
    --
    %% Apple Health on iPhone, Health Connect on Android (Dev 2026-10-11).
    state "Your phone's health data" as Phone {
      [*] --> PhOff
      state "Phone not connected" as PhOff
      state "Phone connected" as PhOn {
        [*] --> PhImporting
        state "Bringing in your history" as PhImporting
        state "Up to date from your phone" as PhCurrent
        PhImporting --> PhCurrent : your phone's history finishes importing
      }
      state "Access turned off in your phone's settings; your readings stay" as PhBlocked
      PhOff --> PhOn : allow your phone's health data
      PhOn --> PhBlocked : access is turned off in your phone's settings
      PhBlocked --> PhOn : access is turned back on in your phone's settings
      PhOn --> PhOff : disconnect your phone's health data
      PhBlocked --> PhOff : disconnect your phone's health data
      PhOn --> PhOff : delete your account
      PhBlocked --> PhOff : delete your account
    }
    %% never OrganizationOnlyWithAccount: Organization connected & No account -- Sources belong to an account; deleting it ends every one (F2).
    %% never PhoneOnlyWithAccount: Phone connected & No account -- Sources belong to an account; deleting it ends every one (F2).
    %% never OrganizationNotWhileDeleting: Organization connected & Deleting your account -- Deletion stops every source at once (F2).
    %% never PhoneNotWhileDeleting: Phone connected & Deleting your account -- Deletion stops every source at once (F2).
    %% never RecordsGoWithAccount: Records kept & No account -- Records are kept until the account is deleted, and not after (F1, F2).
    %% never SessionWithoutAccount: Signed in on this device & No account -- A session always belongs to an account (ENG-111).
    %% never OtherSessionWithoutAccount: Signed in on another device & No account -- A session always belongs to an account (ENG-111).
  }
