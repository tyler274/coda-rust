#!/usr/bin/env bash
# Pre-commit gate (ENG-60): rustfmt and clippy must pass before a commit
# lands. Wired up by the flake shellHook via `git config core.hooksPath
# .githooks`. Escape hatch for exceptional commits: `git commit --no-verify`.
#
# The checks always run in this checkout's dev shell. Outside it, host tools
# shadow the flake's (swiftly's ld.lld fails without libxml2.so.2), so the
# hook re-executes itself under `nix develop` instead of using host cargo.
# The flake shellHook exports CODA_DEV_SHELL=1 as its last step.
#
# Clippy denies warnings on the host and browser builds, matching the CI lint
# steps.
set -euo pipefail

root=$(git rev-parse --show-toplevel)

if [ "${CODA_DEV_SHELL:-}" != 1 ]; then
  if [ -n "${CODA_PRE_COMMIT_REEXEC:-}" ]; then
    echo "pre-commit: nix develop did not provide the dev shell (CODA_DEV_SHELL unset)" >&2
    exit 1
  fi
  if ! command -v nix >/dev/null; then
    echo "pre-commit: nix is not on PATH; cannot enter the dev shell" >&2
    if command -v container >/dev/null; then
      echo "pre-commit: commit through the Apple container: dev/apple-session.sh exec git commit ..." >&2
    fi
    exit 1
  fi
  export CODA_PRE_COMMIT_REEXEC=1
  exec nix develop "$root" --command "$0" "$@"
fi

cd "$root"
if [ "${CODA_FAST_PRECOMMIT:-0}" = 1 ]; then
  exec bash scripts/dev-check.sh --pre-commit
fi
cargo fmt --all --check
python3 scripts/check-sql.py
cargo clippy --workspace --all-targets --quiet -- -D warnings
cargo clippy -p physician-app -p duet-app -p mobile -p ui-gallery -p extension-popup \
  --target wasm32-unknown-unknown \
  --features physician-app/web,duet-app/web,mobile/web,ui-gallery/web,extension-popup/web \
  --quiet -- -D warnings
