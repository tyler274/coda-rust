#!/bin/sh
# Experimental Docker-backed PostgreSQL 16 test binaries (pgvector/pgvector:pg16),
# for hosts where the nix dev shell's /run/postgresql socket directory is unwritable.
#
# Usage:
#   CODA_TEST_POSTGRES_BIN="$PWD/scripts/docker-pg16-bin" pnpm vitest run ...
#
# All three wrappers (initdb, pg_ctl, postgres) share one long-lived helper
# container ("coda-test-pg16") with the host's PID and network namespaces and
# /tmp bind-mounted at its host path. The harness's tmpdir clusters therefore
# appear at identical paths, postgres binds 127.0.0.1 ports on the host, and a
# later "pg_ctl stop" can signal the postmaster an earlier "pg_ctl start" left
# running. Stopping the helper releases everything:
#   docker rm -f coda-test-pg16
#
# Experimental: smoke-tested (version output) only; not wired into the nix dev
# shell. The flake.nix shellHook path remains the default.
set -eu

IMAGE='pgvector/pgvector:pg16@sha256:7b822b0aac60967beb1ea5e576b8602c94c300a157d187f385ae3e0da199b90a'
HELPER=coda-test-pg16

if ! docker inspect -f '{{.State.Running}}' "$HELPER" 2>/dev/null | grep -qx true; then
  docker image inspect "$IMAGE" >/dev/null 2>&1 || docker pull "$IMAGE" >/dev/null
  docker rm -f "$HELPER" >/dev/null 2>&1 || true
  mounts="-v /tmp:/tmp"
  if [ -n "${TMPDIR:-}" ] && [ "$TMPDIR" != /tmp ]; then mounts="$mounts -v $TMPDIR:$TMPDIR"; fi
  docker run -d --name "$HELPER" --pid host --network host $mounts "$IMAGE" sleep infinity >/dev/null
fi

exec docker exec -u "$(id -u):$(id -g)" "$HELPER" /usr/lib/postgresql/16/bin/initdb "$@"
