{
  "models": {
    "claude-opus": {
      "adapter": "claude-cli",
      "model": "opus",
      "key": { "item": "anthropic", "env": "ANTHROPIC_API_KEY" },
      "display_name": "Claude Opus (Claude Code)",
      "notes": "Claude Code headless; can fork another claude-cli member"
    },
    "gpt-codex": {
      "adapter": "codex-cli",
      "model": "gpt-5-codex",
      "key": { "item": "openai", "env": "CODEX_API_KEY" },
      "display_name": "GPT-5 Codex (Codex CLI)",
      "notes": "Codex exec; can fork another codex-cli member"
    },
    "gemini-pro": {
      "adapter": "gemini-cli",
      "model": "gemini-2.5-pro",
      "key": { "item": "gemini", "env": "GEMINI_API_KEY" },
      "display_name": "Gemini 2.5 Pro (Gemini CLI)",
      "notes": "Gemini CLI; no fork"
    },
    "claude-sonnet-api": {
      "adapter": "anthropic-http",
      "model": "claude-sonnet-4-5",
      "key": { "item": "anthropic", "env": "ANTHROPIC_API_KEY" },
      "max_tokens": 8192,
      "max_calls": 32,
      "notes": "Messages API with the swarm tools only"
    },
    "qwen-coder-openrouter": {
      "adapter": "openai-http",
      "base_url": "https://openrouter.ai/api/v1",
      "model": "qwen/qwen3-coder",
      "key": { "item": "openrouter", "env": "OPENROUTER_API_KEY" },
      "notes": "OpenRouter chat completions with the swarm tools only"
    },
    "qwen-coder-local": {
      "adapter": "openai-http",
      "base_url": "http://10.233.1.1:11434/v1",
      "model": "qwen2.5-coder:32b",
      "notes": "Ollama on the sandbox host; no key"
    }
  }
}
