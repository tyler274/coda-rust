{
  "paths": {
    "/api/apple-health/generation": {"get":{"operationId":"readAppleHealthGeneration","security":[{"HTTPBearer":[]}],"responses":{"200":{"description":"Current source generation for this authenticated patient. Capture it when connecting this installation.","content":{"application/json":{"schema":{"type":"integer","format":"int32"}}}}}}},
    "/api/evidence/browse": {"post":{"operationId":"browseEvidenceRecords","security":[{"HTTPBearer":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EvidenceBrowseQuery"}}}},"responses":{"200":{"description":"One bounded page of the complete exact record inventory, ordered newest-first with undated records last. Source-removed records stay listed and labelled; erased records are absent. Continue with next_cursor until it is null; never truncated.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EvidenceBrowsePage"}}}},"409":{"description":"Evidence changed since the cursor was issued; restart from the first page"}}}},
    "/api/evidence/revision": {"post":{"operationId":"readEvidenceRevision","security":[{"HTTPBearer":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EvidenceRevisionRequest"}}}},"responses":{"200":{"description":"The exact addressed revision with its truthful status","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EvidenceRevisionView"}}}},"404":{"description":"Not owned by this account, or absent"}}}},
    "/api/conversation/messages/{message_id}/sources/{source_id}/revision": {"get":{"operationId":"readConversationSourceRevision","security":[{"HTTPBearer":[]}],"parameters":[{"name":"message_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"source_id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"The exact cited record revision, even after later correction or source removal; status unavailable without payload after privacy erasure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EvidenceRevisionView"}}}},"404":{"description":"Not a record citation attached to this account message"}}}},
    "/api/conversation/commands/{id}/usage":{"get":{"operationId":"readDurableConversationUsage","security":[{"HTTPBearer":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Content-free account-scoped physical attempts, nullable input/output totals, unknown usage count and query-time decimal USD estimate. Unknown usage or an unpriced model makes total cost unknown, never a partial subtotal. Explicit reported zero stays zero. Invoice is authoritative, not this estimate.","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"404":{"description":"Command absent from this account"}}}},
    "/api/health-context": {"get":{"operationId":"readCanonicalHealthContext","security":[{"HTTPBearer":[]}],"responses":{"200":{"description":"Current canonical context or null; stale dependencies fail closed"},"409":{"description":"Context refresh required"}}}},
    "/api/insight-cycles/status":{"post":{"operationId":"readTodayAssessmentStatus","security":[{"HTTPBearer":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DurableTodaySlot"}}}},"responses":{"200":{"description":"Ready, generating, missing or unavailable, kept distinct"}}}},
    "/api/conversation/{id}":{"get":{"operationId":"readDurableConversation","security":[{"HTTPBearer":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Retained commands and committed replies","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}}}}},
    "/api/conversation/{id}/commands":{"post":{"operationId":"acceptDurableConversationCommand","security":[{"HTTPBearer":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["id","expected_revision","text"],"properties":{"id":{"type":"string","format":"uuid"},"expected_revision":{"type":"integer","format":"int64"},"text":{"type":"string","maxLength":32000},"submission":{"$ref":"#/components/schemas/DurableConversationSubmission"}}}}}},"responses":{"200":{"description":"Same accepted command identity","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"409":{"description":"Command or conversation changed"},"503":{"description":"Provider disabled; no scripted reply"}}}},
    "/api/conversation/commands/{id}/resume":{"post":{"operationId":"resumeDurableConversationCommand","security":[{"HTTPBearer":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Same work reclaimed or already active"}}}},
    "/api/conversation/commands/{id}/events":{"get":{"operationId":"readDurableConversationEvents","security":[{"HTTPBearer":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"Last-Event-ID","in":"header","schema":{"type":"integer","format":"int64"}},{"name":"after","in":"query","schema":{"type":"integer","format":"int64","minimum":0}}],"responses":{"200":{"description":"Finite account and command scoped SSE batch ordered by event id. Resume after the last applied id; duplicate replay is harmless. claimed and stream_reset clear provisional text; provisional_text carries claim, exchange and unapproved text. completed and interrupted clear the preview and require canonical transcript readback. Events never authorize clinical publication; every read rechecks accepted permission and source fences.","content":{"text/event-stream":{"schema":{"type":"string"}}}}}}},
    "/api/doctor-collection/save-receipts/{generation}":{"get":{"operationId":"readDoctorSaveReceipt","security":[{"HTTPBearer":[]}],"parameters":[{"name":"generation","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Exact current save acknowledgement after privacy confirmation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DoctorCollection"}}}},"404":{"description":"No retained current acknowledgement"},"503":{"description":"Privacy confirmation pending"}}}},
    "/api/doctor-collection/proposals/{id}/reject":{"post":{"operationId":"rejectDurableDoctorProposal","security":[{"HTTPBearer":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["expected_generation"],"properties":{"expected_generation":{"type":"integer","format":"int64"}}}}}},"responses":{"200":{"description":"Approved collection unchanged; proposal rejected","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DoctorCollection"}}}},"409":{"description":"Workspace or proposal changed"}}}},
    "/shl/{token}/manifest":{"post":{"operationId":"retrieveSmartHealthLinkManifest","security":[],"parameters":[{"name":"token","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"responses":{"200":{"description":"Short-lived revocation-checked file locations","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"404":{"description":"Unavailable link"}}}},
    "/shl-file/{location}":{"get":{"operationId":"retrieveSmartHealthLinkFile","security":[],"parameters":[{"name":"location","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Compact dir/A256GCM JWE","content":{"application/jose":{"schema":{"type":"string"}}}},"404":{"description":"Expired or unavailable file"}}}},
    "/shared/for-my-doctor/{token}/pdf":{"get":{"operationId":"retrievePublishedDoctorPdf","security":[],"parameters":[{"name":"token","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Exact pinned PDF","content":{"application/pdf":{"schema":{"type":"string","format":"binary"}}}},"404":{"description":"Unavailable link"}}}},
    "/api/doctor-collection/share-link": {
      "post":{"operationId":"publishApprovedDoctorPage","security":[{"HTTPBearer":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DurablePublishRequest"}}}},"responses":{"200":{"description":"Pinned publication","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DurablePublicationView"}}}},"409":{"description":"Stale page/source or faithful export blocked"},"503":{"description":"Privacy confirmation pending; retry same operation"}}},
      "get":{"operationId":"readDoctorPublication","security":[{"HTTPBearer":[]}],"responses":{"200":{"description":"Latest publication or null; conditional atomic revoke supported","headers":{"Duet-Publication-Precondition":{"schema":{"type":"string","enum":["uuid-v1"]}}},"content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/DurablePublicationView"}],"nullable":true}}}}}},
      "delete":{"operationId":"revokeDoctorPublication","security":[{"HTTPBearer":[]}],"parameters":[{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"If-Match","in":"header","required":true,"description":"Bare UUID of the reviewed publication, not a quoted ETag or wildcard. Retry with the same operation and target after uncertain acknowledgement.","schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Exact target revoked and independently confirmed; original successful retries remain acknowledged after replacement","headers":{"Duet-Publication-Precondition":{"schema":{"type":"string","enum":["uuid-v1"]}}}},"409":{"description":"Reviewed target is no longer active or operation identity was already bound to another target"},"428":{"description":"Reviewed publication If-Match precondition missing"},"422":{"description":"Malformed publication UUID or missing/invalid operation UUID"},"503":{"description":"Effective restriction pending journal confirmation; retry the same operation and target"}}}
    },
    "/api/doctor-collection/preview":{"get":{"operationId":"previewApprovedDoctorPage","security":[{"HTTPBearer":[]}],"responses":{"200":{"description":"Complete SVG preview including overflow","content":{"image/svg+xml":{"schema":{"type":"string"}}}}}}},
    "/api/doctor-collection/pdf":{"get":{"operationId":"exportApprovedDoctorPage","security":[{"HTTPBearer":[]}],"responses":{"200":{"description":"Exact faithful one-page PDF","content":{"application/pdf":{"schema":{"type":"string","format":"binary"}}}},"409":{"description":"Source changed, overflow, or unsupported glyph"}}}},
    "/api/auth/account/context": {
      "get": {
        "operationId": "readDurableAccountContext",
        "security": [{"HTTPBearer": []}],
        "responses": {"200": {"description": "Verified account and permission fence; capture before requests", "content": {"application/json": {"schema": {"type": "object", "required": ["account_id", "incarnation", "permission_revision", "authenticated_at"], "properties": {"account_id": {"type": "string", "format": "uuid"}, "incarnation": {"type": "string", "format": "uuid"}, "permission_revision": {"type": "integer", "format": "int64"}, "authenticated_at": {"type": "string", "format": "date-time"}}}}}}}
      }
    },
    "/api/auth/privacy-restrictions": {
      "post": {
        "operationId": "commitDurablePrivacyRestriction",
        "security": [{"HTTPBearer": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DurableRestrictionRequest"}}}},
        "responses": {
          "200": {"description": "Restriction committed and identical independent journal bytes read back", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DurablePrivacyReceipt"}}}},
          "409": {"description": "Operation bytes or resource incarnation differ"},
          "503": {"description": "Restriction may be effective; retry the same event identity to reconcile receipt"}
        }
      }
    },
    "/api/canonical-evidence": {
      "post": {
        "operationId": "ingestCanonicalEvidence",
        "security": [{"HTTPBearer": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CanonicalEvidenceMutation"}}}},
        "responses": {"200": {"description": "Immutable exact source address", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CanonicalSourceAddress"}}}}, "409": {"description": "Source changed, ingestion identity reused, or source_authority_refused"}, "404": {"description": "Explicit source removal names no current record"}, "422": {"description": "Malformed or unbounded source object"}}
      },
      "get": {
        "operationId": "readCanonicalEvidenceSnapshot",
        "security": [{"HTTPBearer": []}],
        "parameters": [{"name": "after", "in": "query", "schema": {"type": "integer", "format": "int64", "minimum": 0, "default": 0}}],
        "responses": {"200": {"description": "Complete account-consistent delta including tombstones", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CanonicalEvidenceSnapshot"}}}}}
      }
    },
    "/api/canonical-evidence/batch": {
      "post": {
        "operationId": "ingestCanonicalEvidenceBatch",
        "security": [{"HTTPBearer": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CanonicalEvidenceBatch"}}}},
        "responses": {"200": {"description": "One outcome per item in request order; each item committed or rolled back alone, none skipped", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CanonicalEvidenceBatchResult"}}}}, "422": {"description": "Batch empty or over 100 items"}}
      }
    },
    "/api/canonical-evidence/exact": {
      "post": {
        "operationId": "readCanonicalEvidenceExact",
        "security": [{"HTTPBearer": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["address"], "properties": {"address": {"$ref": "#/components/schemas/CanonicalSourceAddress"}, "require_current": {"type": "boolean", "default": false}}}}}},
        "responses": {"200": {"description": "Exact immutable source payload", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CanonicalExactEvidence"}}}}, "404": {"description": "Not owned, privacy-erased, withdrawn, or absent"}, "409": {"description": "require_current and the revision was corrected or removed by its source"}}
      }
    }
  },
  "components": {
    "schemas": {
      "FollowUpRestrictionRequest":{"type":"object","additionalProperties":false,"required":["event_id","expected_revision"],"properties":{"event_id":{"type":"string","format":"uuid"},"expected_revision":{"type":"integer","format":"int64","minimum":1}}},
      "DurableTodaySlot":{"type":"object","additionalProperties":false,"required":["kind","window_start","window_end","timezone","first_weekday","snapshot_id"],"properties":{"kind":{"type":"string","enum":["daily","weekly"]},"window_start":{"type":"string","format":"date-time"},"window_end":{"type":"string","format":"date-time"},"timezone":{"type":"string"},"first_weekday":{"type":"integer","minimum":1,"maximum":7},"snapshot_id":{"type":"string","format":"uuid"}}},
      "CanonicalContextUpload":{"type":"object","additionalProperties":false,"required":["snapshot"],"properties":{"expected_revision":{"type":"integer","format":"int64","nullable":true},"snapshot":{"$ref":"#/components/schemas/CanonicalContextCapture"}}},
      "CanonicalContextCapture":{"type":"object","additionalProperties":false,"required":["id","source_boundary_id","schema_version","generated_at","timezone","projections"],"properties":{"id":{"type":"string","format":"uuid"},"source_boundary_id":{"type":"string","format":"uuid"},"schema_version":{"type":"integer"},"generated_at":{"type":"string","format":"date-time"},"timezone":{"type":"string"},"source_generations":{"type":"object","additionalProperties":{"type":"integer","format":"int64"}},"projections":{"type":"array","items":{"$ref":"#/components/schemas/CanonicalContextProjection"}}}},
      "CanonicalContextProjection":{"type":"object","additionalProperties":false,"required":["kind","window_start","window_end","timezone","first_weekday"],"properties":{"kind":{"type":"string","enum":["daily","weekly"]},"window_start":{"type":"string","format":"date-time"},"window_end":{"type":"string","format":"date-time"},"timezone":{"type":"string"},"first_weekday":{"type":"integer","minimum":1,"maximum":7},"facts":{"type":"array","description":"Only supported native supplemental namespaces; measurement facts are server-derived, never trusted uploads","items":{"$ref":"#/components/schemas/HealthFact-Input"}}}},
      "DurableConversationSubmission": {"type":"object","additionalProperties":false,"required":["timezone"],"properties":{"timezone":{"type":"string","maxLength":128},"reply_to_message_id":{"type":"string","format":"uuid","nullable":true},"selected_context":{"oneOf":[{"$ref":"#/components/schemas/SelectedFollowUpContext"},{"$ref":"#/components/schemas/SelectedPublishedInsightContext"},{"$ref":"#/components/schemas/SelectedRecordContext"},{"$ref":"#/components/schemas/SelectedMeasurementContext-Input"}],"nullable":true,"discriminator":{"propertyName":"kind","mapping":{"follow_up":"#/components/schemas/SelectedFollowUpContext","published_insight":"#/components/schemas/SelectedPublishedInsightContext","record":"#/components/schemas/SelectedRecordContext","measurement":"#/components/schemas/SelectedMeasurementContext-Input"}}}}},
      "CanonicalSourceAddress": {"type":"object","required":["canonical_record_id","record_id","entity","revision"],"properties":{"canonical_record_id":{"type":"string","format":"uuid"},"record_id":{"type":"string"},"entity":{"type":"string","enum":["clinical_note","health_evidence"]},"revision":{"type":"integer","format":"int32"}}},
      "DurablePublishRequest": {"type":"object","required":["operation_id","expected_generation"],"properties":{"operation_id":{"type":"string","format":"uuid"},"expected_generation":{"type":"integer","format":"int64"},"expires_in_seconds":{"type":"integer","format":"int64","default":604800,"minimum":60,"maximum":2592000}}},
      "DurablePublicationView": {"type":"object","required":["id","generation","expires_at","revoked","web_url","shl_url","content_sha256"],"properties":{"id":{"type":"string","format":"uuid"},"generation":{"type":"integer","format":"int64"},"expires_at":{"type":"string","format":"date-time"},"revoked":{"type":"boolean"},"web_url":{"type":"string"},"shl_url":{"type":"string"},"content_sha256":{"type":"string"}}},
      "DurableRestrictionRequest": {"type": "object", "required": ["event_id", "operation", "scope_version"], "properties": {"event_id": {"type": "string", "format": "uuid"}, "operation": {"type": "string", "enum": ["luna_withdraw", "sessions_revoke", "evidence_delete", "doctor_page_delete", "doctor_note_delete", "doctor_item_delete", "publication_revoke", "device_withdraw", "records_withdraw", "follow_up_pause", "follow_up_cancel", "account_delete"]}, "scope_id": {"type": "string", "format": "uuid", "nullable": true}, "scope_version": {"type": "integer", "format": "int64"}}},
      "DurablePrivacyReceipt": {"type": "object", "additionalProperties": false, "required": ["schema_version", "event_id", "account_id", "account_incarnation", "operation", "scope_id", "scope_version", "occurred_at"], "properties": {"schema_version": {"type": "integer"}, "event_id": {"type": "string", "format": "uuid"}, "account_id": {"type": "string", "format": "uuid"}, "account_incarnation": {"type": "string", "format": "uuid"}, "operation": {"type": "string", "enum": ["luna_withdraw", "sessions_revoke", "evidence_delete", "doctor_page_delete", "doctor_note_delete", "doctor_item_delete", "publication_revoke", "device_withdraw", "records_withdraw", "follow_up_pause", "follow_up_cancel", "account_delete"]}, "scope_id": {"type": "string", "format": "uuid"}, "scope_version": {"type": "integer", "format": "int64"}, "occurred_at": {"type": "string", "format": "date-time"}}},
      "CanonicalEvidenceMutation": {"type": "object", "additionalProperties": false, "required": ["operation_id", "canonical_record_id", "record_id", "entity", "payload"], "properties": {"operation_id": {"type": "string", "format": "uuid"}, "canonical_record_id": {"type": "string", "format": "uuid"}, "record_id": {"type": "string"}, "entity": {"type": "string", "enum": ["clinical_note", "health_evidence"]}, "expected_revision": {"type": "integer", "format": "int64", "nullable": true}, "source_generation":{"type":"integer","format":"int32","nullable":true}, "operation": {"type": "string", "enum": ["upsert", "delete"], "default": "upsert", "description": "delete is an explicit source removal: payload is exactly {\"source\":{\"kind\":..}} and expected_revision is the exact current revision. Retained revisions stay citable as non-current; it is not privacy erasure."}, "payload": {"type": "object", "additionalProperties": true, "description": "Literal source object. Health evidence measured_at or measured_interval.start is projected only when an RFC 3339 instant; otherwise the stored date is unknown (null), never receipt time."}}},
      "CanonicalExactEvidence": {"type": "object", "required": ["address", "payload", "current"], "properties": {"address": {"$ref": "#/components/schemas/CanonicalSourceAddress"}, "payload": {"type": "object", "additionalProperties": true}, "current": {"type": "boolean"}}},
      "CanonicalEvidenceChange": {"type": "object", "required": ["entity", "canonical_record_id", "record_id", "revision", "deleted"], "properties": {"entity": {"type": "string", "enum": ["clinical_note", "health_evidence"]}, "canonical_record_id": {"type": "string", "format": "uuid"}, "record_id": {"type": "string"}, "revision": {"type": "integer", "format": "int64"}, "deleted": {"type": "boolean"}, "source_removed": {"type": "boolean", "default": false, "description": "Removed by its source; retained revisions remain citable. False for privacy erasure."}}},
      "CanonicalEvidenceSnapshot": {"type": "object", "required": ["cursor", "changes", "records"], "properties": {"cursor": {"type": "integer", "format": "int64"}, "changes": {"type": "array", "items": {"$ref": "#/components/schemas/CanonicalEvidenceChange"}}, "records": {"type": "array", "items": {"$ref": "#/components/schemas/CanonicalExactEvidence"}}}},
      "CanonicalEvidenceBatch": {"type": "object", "additionalProperties": false, "required": ["items"], "properties": {"items": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/components/schemas/CanonicalEvidenceMutation"}}}},
      "CanonicalEvidenceRejection": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string", "enum": ["conflict", "source_authority_refused", "invalid", "not_found"]}, "message": {"type": "string"}}},
      "CanonicalEvidenceItemOutcome": {"type": "object", "required": ["status", "index", "operation_id"], "properties": {"status": {"type": "string", "enum": ["accepted", "rejected"]}, "index": {"type": "integer", "minimum": 0}, "operation_id": {"type": "string", "format": "uuid"}, "address": {"$ref": "#/components/schemas/CanonicalSourceAddress"}, "rejection": {"$ref": "#/components/schemas/CanonicalEvidenceRejection"}}},
      "CanonicalEvidenceBatchResult": {"type": "object", "required": ["results"], "properties": {"results": {"type": "array", "items": {"$ref": "#/components/schemas/CanonicalEvidenceItemOutcome"}}}},
      "EvidenceBrowseQuery": {"type":"object","additionalProperties":false,"properties":{"cursor":{"type":"string","description":"Opaque continuation from the previous page"},"include_removed":{"type":"boolean","default":true,"description":"List source-removed records (labelled) alongside current ones"}}},
      "EvidenceRecordProvenance": {"type":"object","required":["source_kind","writer"],"properties":{"source_kind":{"type":"string"},"writer":{"type":"string","enum":["device","connector"]},"connection_id":{"type":"string"},"source_record_id":{"type":"string"},"source_label":{"type":"string"}}},
      "EvidenceBrowseRecord": {"type":"object","required":["address","status","title","provenance","payload"],"properties":{"address":{"$ref":"#/components/schemas/CanonicalSourceAddress"},"status":{"type":"string","enum":["current","removed_by_source"]},"title":{"type":"string"},"provenance":{"$ref":"#/components/schemas/EvidenceRecordProvenance"},"date":{"type":"string","description":"Literal declared date string; absent means the date is unknown"},"date_end":{"type":"string","description":"Literal interval end when it differs from date. Absent for a single instant."},"date_role":{"type":"string"},"time_zone":{"type":"string"},"value":{"type":"string","description":"Literal value exactly as declared"},"unit":{"type":"string"},"source_status":{"type":"string"},"payload":{"type":"object","additionalProperties":true}}},
      "EvidenceBrowsePage": {"type":"object","required":["revision","health_records_generation","total_count","records"],"properties":{"revision":{"type":"integer","format":"int64"},"health_records_generation":{"type":"integer","format":"int32"},"total_count":{"type":"integer","format":"int32"},"removed_count":{"type":"integer","format":"int32"},"next_cursor":{"type":"string"},"records":{"type":"array","items":{"$ref":"#/components/schemas/EvidenceBrowseRecord"}}}},
      "EvidenceRevisionRequest": {"type":"object","additionalProperties":false,"required":["address"],"properties":{"address":{"$ref":"#/components/schemas/CanonicalSourceAddress"}}},
      "EvidenceRevisionView": {"type":"object","required":["address","status","current"],"properties":{"address":{"$ref":"#/components/schemas/CanonicalSourceAddress"},"status":{"type":"string","enum":["current","superseded","removed_by_source","unavailable"]},"current":{"type":"boolean"},"newer_revision_exists":{"type":"boolean"},"current_revision":{"type":"integer","format":"int64"},"payload":{"type":"object","additionalProperties":true},"reference":{"$ref":"#/components/schemas/ConversationSource"}}}
    }
  }
}
