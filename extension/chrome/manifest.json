{
  "manifest_version": 3,
  "name": "Coda",
  "version": "0.4.0",
  "key": "",
  "description": "Connects your signed-in browser session to Coda in the background, read only.",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Coda",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/coda-16.png",
      "32": "icons/coda-32.png",
      "48": "icons/coda-48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/coda-16.png",
    "32": "icons/coda-32.png",
    "48": "icons/coda-48.png",
    "128": "icons/coda-128.png"
  }
}
