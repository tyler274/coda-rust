{
  "name": "coda-rust",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "remoteEnv": {
    // Local bootstrap administrator. Follow README schema setup, then override
    // DATABASE_URL with the distinct runtime login before running duet-api.
    "DATABASE_URL": "postgres://coda@127.0.0.1:5433/duet"
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "tamasfe.even-better-toml"]
    }
  }
}
