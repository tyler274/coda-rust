{
  "mcpServers": {
    "github": {
      "type": "stdio",
      "command": "./scripts/github-mcp.sh"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    },
    "nixos": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-nixos==3.1.0"]
    },
    "slack": {
      "url": "https://mcp.slack.com/mcp",
      "auth": { "CLIENT_ID": "3660753192626.8903469228982" }
    },
    "datadog": {
      "url": "https://mcp.datadoghq.com/v1/mcp?toolsets=core"
    },
    "langfuse": {
      "url": "http://localhost:3000/api/public/mcp",
      "headers": { "Authorization": "Basic cGstbGYtY29kYS1sb2NhbC1kZXY6c2stbGYtY29kYS1sb2NhbC1kZXY=" }
    },
    "coda-swarm": {
      "type": "stdio",
      "command": "coda-swarm",
      "args": [
        "mcp",
        "--create",
        "--agent",
        "coordinator",
        "--dir",
        "${workspaceFolder}/.swarm",
        "--models",
        "${workspaceFolder}/.swarm/models.json"
      ]
    }
  }
}
